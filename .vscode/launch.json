{
  "version": "0.2.0",
  "configurations": [
    {
      "name": ".NET Core Launch (macOS)",
      "type": "coreclr",
      "request": "launch",
      "preLaunchTask": "build",
      "program": "/Applications/Godot_mono.app/Contents/MacOS/Godot",
      "args": [],
      "cwd": "${workspaceFolder}",
      "console": "internalConsole",
      "stopAtEntry": false,
      "justMyCode": true,
      "symbolOptions": {
        "searchMicrosoftSymbolServer": false,
        "searchNuGetOrgSymbolServer": false,
        "moduleFilter": {
          "mode": "loadOnlyIncluded",
          "includedModules": ["starter-template.dll"]
        }
      }
    },
    {
      "name": ".NET Core Launch (Windows)",
      "type": "coreclr",
      "request": "launch",
      "preLaunchTask": "build",
      "program": "C:/Godot_v4.4-stable_mono_win64.exe",
      "args": [],
      "cwd": "${workspaceFolder}",
      "console": "internalConsole",
      "stopAtEntry": false,
      "justMyCode": true,
      "symbolOptions": {
        "searchMicrosoftSymbolServer": false,
        "searchNuGetOrgSymbolServer": false,
        "moduleFilter": {
          "mode": "loadOnlyIncluded",
          "includedModules": ["starter-template.dll"]
        }
      }
    },
    {
      "name": ".NET Core Attach",
      "type": "coreclr",
      "request": "attach"
    }
  ]
}
